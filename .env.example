POSTGRES_DB=pangea
POSTGRES_USER=pangea
POSTGRES_PASSWORD=changeme

VK_TOKEN=your_vk_token_here

# Секретный ключ Callback API группы (Управление → Работа с API → Callback API →
# «Секретный ключ»). Пока пусто, конкурс активности не считает лайки и
# комментарии: без ключа их легко подделать, а за них дают дублоны.
VK_SECRET=

# Слушать ВК ещё и по Long Poll, рядом с Callback API: сообщение идёт в ход тем
# путём, которым пришло первым. Нужен и тумблер в настройках сообщества (см.
# README, «Long Poll»).
VK_LONG_POLL=false

# Адрес сервера для HTTPS (без https://), например pangea.example.ru: на нём
# Caddy отдаёт VK Mini App и маршруты бота /api, /pay, /logs. Имя должно уже
# указывать на IP сервера. Пусто — HTTPS выключен.
DOMAIN=

# Защищённый ключ VK Mini App (настройки приложения в ВК): им ВК подписывает
# параметры запуска, по ним API Mini App узнаёт игрока. Пусто — API выключен.
VK_APP_SECRET=

# Пароль админ-панели («/admin» в личке бота) и выдачи логов по HTTP (GET /logs).
# Пусто — и панель, и логи закрыты для всех.
ADMIN_PASSWORD=

# Касса Т-Банка (донат). Пока TBANK_TERMINAL_KEY и TBANK_PASSWORD пусты,
# покупка дублонов у Рахадима выключена и экран остаётся заглушкой.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Вебхук со статусами платежей: HTTPS-адрес этого приложения + /pay/tbank/notify
TBANK_NOTIFICATION_URL=https://example.com/pay/tbank/notify
# Куда банк возвращает браузер игрока после оплаты. По умолчанию — сообщество;
# можно точнее, сразу в диалог, если знаешь числовой id: https://vk.ru/im?sel=-123456789
TBANK_SUCCESS_URL=https://vk.ru/stigmapangeaproject
TBANK_FAIL_URL=https://vk.ru/stigmapangeaproject
# Оферта: показывается на экране подтверждения покупки
TBANK_OFFER_URL=https://example.com/offer
# Налоговые поля чека — подтвердить с бухгалтерией
TBANK_TAXATION=usn_income
TBANK_TAX=none
TBANK_PAYMENT_OBJECT=service

# Кому писать в ВК, если ночной бэкап базы не сделан (scripts/backup-db.sh):
# VK id через запятую. Пишет сообщество — тем же VK_TOKEN.
BACKUP_ALERT_VK_IDS=

# Пароль admin в Grafana (графики метрик: http://<IP сервера>:3000). Порт
# открыт наружу, поэтому без пароля Grafana не запускается. Отдельный пароль:
# по HTTP он идёт открытым текстом.
GRAFANA_PASSWORD=
