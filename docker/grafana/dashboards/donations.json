{
  "uid": "pangea-donations",
  "title": "Донат",
  "description": "Оплаченные заказы из базы (таблица payments): когда, сколько и кто. Возвраты не в счёт.",
  "tags": [
    "pangea"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "За период, ₽",
      "description": "Сколько заплатили за выбранный период (выданные заказы, без возвратов).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pangea-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pangea-db"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(p.amount_kopecks), 0) / 100.0 AS \"₽\"\nFROM payments p\nWHERE p.granted AND p.status <> 'Refunded' AND $__timeFilter(to_timestamp(p.created_at / 1000.0))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Донатов за период",
      "description": "Сколько оплаченных заказов за выбранный период.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pangea-db"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pangea-db"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"донатов\"\nFROM payments p\nWHERE p.granted AND p.status <> 'Refunded' AND $__timeFilter(to_timestamp(p.created_at / 1000.0))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Донатеров за период",
      "description": "Сколько разных игроков платили за выбранный период.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pangea-db"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
