      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pangea_vk_delivery_lag_seconds_bucket{kind=\"message\", first!=\"no\"}[5m])))",
          "legendFormat": "доставка от ВК до нас (личка)"
