    {
      "id": 18,
      "type": "timeseries",
      "title": "Доставка от ВК по путям: медиана и p95",
      "description": "Личка: от сообщения игрока (время у ВК, точность — секунда) до прихода к нам — отдельно по Callback и по Long Poll, считая и опоздавшие копии. Линия одного пути ниже — он быстрее. Медиана маленькая, а p95 большой — медленный только хвост; обе большие — тормозит всё.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(pangea_vk_delivery_lag_seconds_bucket{kind=\"message\"}[5m])))",
          "legendFormat": "медиана: {{source}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(pangea_vk_delivery_lag_seconds_bucket{kind=\"message\"}[5m])))",
          "legendFormat": "p95: {{source}}"
        }
