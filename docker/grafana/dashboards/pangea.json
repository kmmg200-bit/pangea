          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pangea_vk_api_seconds_bucket[5m])))",
          "legendFormat": "вызов API ВК"
