      "description": "Сколько ходов игроков и событий ВК приходит в минуту.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
