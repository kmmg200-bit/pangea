# Входная дверь: порты 80 и 443 — только у Caddy, сборщик и бот наружу не
# смотрят. Пока бот или сборщик перезапускается, запрос ждёт его до 10 секунд
# (lb_try_duration), а не получает ошибку сразу.

# Порт 80, по HTTP: колбэк ВК (http://<IP>/) — сборщику, вебхук кассы
# (http://<IP>/pay/…), Mini App API и логи — боту. Адреса прежние: их знают ВК
# и касса.
http:// {
	@bot path /api/* /pay/* /logs /logs/*
	handle @bot {
		reverse_proxy app:8080 {
			lb_try_duration 10s
		}
	}
	handle {
		reverse_proxy collector:8080 {
			lb_try_duration 10s
		}
	}
}

# Порт 443, по HTTPS на адресе DOMAIN из .env: VK Mini App (статика из web/) и
# те же маршруты бота. Сертификат Caddy получает через TLS-ALPN на 443, проверку
# через HTTP выключаем — она не нужна.
{$DOMAIN} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode zstd gzip

	# Бот: API Mini App, вебхук кассы, выдача логов.
	@bot path /api/* /pay/* /logs /logs/*
	handle @bot {
		reverse_proxy app:8080 {
			lb_try_duration 10s
		}
	}

	# Mini App. Файлы сборки с хешем в имени не меняются — их кешируем надолго,
	# а страницу — нет: иначе игрок не увидит новую версию.
	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
